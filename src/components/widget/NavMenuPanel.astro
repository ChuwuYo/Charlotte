---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed fixed right-4 px-2 py-2"]}>
    {links.map((link, index) => {
        const hasChildren = link.children && link.children.length > 0;
        
        if (hasChildren) {
            // Index, not the configurable name, so it cannot collide with another id
            const contentId = `nav-menu-group-${index}`;
            return (
                <div data-mobile-dropdown>
                    <button 
                        class="group peer flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8 w-full
 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition-ui"
                        aria-controls={contentId}
                        data-mobile-dropdown-trigger
                    >
                        <div class="transition-ui text-75 font-bold group-hover:text-[var(--primary-text)] group-active:text-[var(--primary-text)]">
                            {link.name}
                        </div>
                        <Icon name="material-symbols:keyboard-arrow-down-rounded"
                              class="transition-transform icon-5 text-(--primary-text) duration-200 group-aria-expanded:rotate-180"
                        />
                    </button>
                    <div class="overflow-hidden transition-[max-height,visibility] duration-200 max-h-0 invisible peer-aria-expanded:visible" id={contentId} data-mobile-dropdown-content>
                        <div class="pl-4 py-1">
                            {link.children!.map((child) => (
                                <a href={child.external ? child.url : url(child.url)} 
                                   class="group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8
 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition-ui
 "
                                   target={child.external ? "_blank" : null}
                                >
                                    <div class="transition-ui text-50 font-medium group-hover:text-[var(--primary-text)] group-active:text-[var(--primary-text)]">
                                        {child.name}
                                    </div>
                                    {child.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                                          class="icon-3 text-50 -translate-x-1"
                                    />}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            );
        } else {
            return (
                <a href={link.external ? link.url : url(link.url)} class="group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8
 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition-ui
 "
                   target={link.external ? "_blank" : null}
                >
                    <div class="transition-ui text-75 font-bold group-hover:text-[var(--primary-text)] group-active:text-[var(--primary-text)]">
                        {link.name}
                    </div>
                    {!link.external && <Icon name="material-symbols:chevron-right-rounded"
                          class="icon-5 text-(--primary-text)"
                    />}
                    {link.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                          class="icon-3 text-50 -translate-x-1"
                    />}
                </a>
            );
        }
    })}
</div>
