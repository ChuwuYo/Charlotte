---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { LinkPreset, type NavBarLink } from "../types/config";
import { iconData } from "../utils/icon-data";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import ImageWrapper from "./misc/ImageWrapper.astro";
import NavDropdown from "./NavDropdown.astro";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

// 获取导航栏透明度配置，默认为 100（完全不透明）
const navbarOpacity = navBarConfig.opacity ?? 100;
// 将百分比转换为 0-1 的小数值
const opacityValue = Math.max(0, Math.min(100, navbarOpacity)) / 100;

// 检查是否在文章页面隐藏按钮
const hideButtonsOnPostPage = navBarConfig.hideButtonsOnPostPage ?? false;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const themeIcons = iconData([
	"material-symbols:wb-sunny-outline-rounded",
	"material-symbols:dark-mode-outline-rounded",
	"material-symbols:radio-button-partial-outline",
]);
const searchIcons = iconData([
	"material-symbols:search",
	"fa6-solid:chevron-right",
]);
const settingsIcons = iconData(["fa6-solid:arrow-rotate-left"]);
---
<div id="navbar" class="z-50 onload-animation" style={`--navbar-opacity: ${opacityValue};`}>
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] pointer-events-none" style={`opacity: ${opacityValue};`}></div>
    <div class:list={[
        className,
        "card-base navbar-with-opacity !overflow-visible max-w-page h-navbar !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-13 px-5 font-bold press">
            <div class="flex flex-row text-[var(--primary-text)] items-center">
                {siteConfig.favicon[0]?.src ? (
                    <div class="w-8 h-8 mr-2 mb-1 rounded-full overflow-hidden border border-[var(--primary)]">
                        <ImageWrapper src={siteConfig.favicon[0].src} alt={`${siteConfig.title} ${i18n(I18nKey.home)}`} class="w-full h-full" loading="eager" />
                    </div>
                ) : (
                    <Icon name="material-symbols:home-outline-rounded" class="icon-7 mb-1 mr-2" aria-label={i18n(I18nKey.home)} />
                )}
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                const hasChildren = l.children && l.children.length > 0;
                
                if (hasChildren) {
                    return <NavDropdown title={l.name} items={l.children!} />;
                }
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg md:h-11 h-12 text-ui font-bold px-5 press"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="icon-3.5 -translate-y-px ml-1 text-30"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="navbar-controls flex items-center" data-post-mode={hideButtonsOnPostPage ? "" : undefined}>
            <div class="search-container">
                <Search icons={searchIcons} client:load></Search>
            </div>
            <div class="buttons-container flex">
                {!siteConfig.themeColor.fixed && (
                        <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg md:h-11 md:w-11 h-12 w-12 press" id="display-settings-switch" aria-controls="display-setting" aria-expanded="false">
                            <Icon name="material-symbols:palette-outline" class="icon-5"></Icon>
                        </button>
                )}
                <LightDarkSwitch icons={themeIcons} client:only="svelte">
                    <!-- 占位，防止导航偏移 -->
                    <div slot="fallback" class="h-11 w-11"></div>
                </LightDarkSwitch>
            </div>
            <button aria-label="Menu" class="btn-plain scale-animation rounded-lg md:w-11 md:h-11 w-12 h-12 press md:!hidden" id="nav-menu-switch" aria-controls="nav-menu-panel" aria-expanded="false">
                <Icon name="material-symbols:menu-rounded" class="icon-5"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        {!siteConfig.themeColor.fixed && <DisplaySettings icons={settingsIcons} client:only="svelte"></DisplaySettings>}
    </div>
</div>

<style>
.navbar-controls {
    position: relative;
}

.buttons-container {
    transition: opacity 0.1s ease-out 0.1s, transform 0.3s ease-out;
}

.search-container {
    transition: transform 0.3s ease-out;
}

/* Post page (html.is-post): hide setting buttons, shift search */
:global(.is-post) .navbar-controls[data-post-mode] .buttons-container {
    opacity: 0;
    pointer-events: none;
    transform: translateX(0);
    transition: opacity 0.1s ease-out, transform 0.3s ease-out;
}

:global(.is-post) .navbar-controls[data-post-mode] > .search-container {
    transform: translateX(var(--buttons-offset, calc(var(--spacing) * 24)));
}
</style>
