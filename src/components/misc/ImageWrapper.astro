---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	// Local images only: widths are generated at build, the browser picks one by sizes and DPR
	widths?: number[];
	sizes?: string;
}

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority = "auto",
	widths,
	sizes,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,gif,svg,avif,PNG,JPG,JPEG,WEBP,GIF,SVG,AVIF}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover image-content opacity-0";
// width/height only give the UA an `auto` ratio, which switches to the loaded file's ratio,
// and srcset candidates have rounded heights. Lock the source ratio instead; slots that set
// both width and height ignore it.
const imageStyle = img
	? `object-position: ${position}; aspect-ratio: ${img.width} / ${img.height}`
	: `object-position: ${position}`;
// Fade the bar out, then stop its infinite animation once it is invisible
const hideBar =
	"const bar = this.parentElement.querySelector('.loading-bar'); bar.style.opacity='0'; setTimeout(() => { bar.firstElementChild.style.animation='none'; }, 1000);";
const onloadScript = `this.style.opacity='1'; ${hideBar} this.parentElement.querySelector('.error-icon').style.opacity='0';`;
const onerrorScript = `${hideBar} this.parentElement.querySelector('.error-icon').style.opacity='1';`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="loading-bar absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-1 bg-gray-200/80 dark:bg-gray-700/80 z-10 rounded-full overflow-hidden transition-opacity duration-500">
        <div class="h-full w-8 bg-[var(--primary)] animate-loading-progress rounded-full"></div>
    </div>
    <div class="error-icon absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl text-30 z-10 opacity-0 transition-opacity duration-500 pointer-events-none">
        <Icon name="material-symbols:image-not-supported-outline-rounded" />
    </div>
    {isLocal && img && <Image src={img} alt={alt || ""} widths={widths} sizes={sizes} class={imageClass} style={imageStyle} loading={loading} fetchpriority={fetchpriority} onload={onloadScript} onerror={onerrorScript}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} fetchpriority={fetchpriority} onload={onloadScript} onerror={onerrorScript}/>}
</div>
