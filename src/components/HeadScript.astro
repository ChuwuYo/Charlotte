---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/config";
import { BANNER_HEIGHT_EXTEND } from "../constants/constants";

const defaultTheme = siteConfig.defaultTheme;
// Display settings hidden: stored hue and card background are ignored
const fixedSettings = siteConfig.themeColor.fixed;
---

<ClientRouter />

<!-- Classic blocking script: settings before first paint -->
<script is:inline define:vars={{ defaultTheme, fixedSettings, BANNER_HEIGHT_EXTEND }}>
	const root = document.documentElement;

	// Theme, hue and card background from storage
	function applySettings() {
		const theme = localStorage.getItem("theme") || defaultTheme;
		const dark =
			theme === "dark" ||
			(theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
		root.classList.toggle("dark", dark);
		const hue = !fixedSettings && localStorage.getItem("hue");
		if (hue) root.style.setProperty("--hue", hue);
		root.style.setProperty(
			"--card-bg",
			!fixedSettings && localStorage.getItem("cardBgType") === "1"
				? "var(--card-bg-themed)"
				: "var(--card-bg-original)",
		);
	}
	applySettings();

	// Banner offset, a multiple of 4px to keep text crisp. On touch screens it is
	// recomputed only when the width changes: mobile toolbars change innerHeight
	// while scrolling.
	const touch = matchMedia("(pointer: coarse)");
	let bannerWidth = 0;
	function setBannerExtend() {
		if (touch.matches && innerWidth === bannerWidth) return;
		bannerWidth = innerWidth;
		const px = Math.floor(innerHeight * (BANNER_HEIGHT_EXTEND / 100));
		root.style.setProperty("--banner-height-extend", `${px - (px % 4)}px`);
	}
	setBannerExtend();
	addEventListener("resize", setBannerExtend);

	// Overlay page scrollbar with a mouse
	if (matchMedia("(hover: hover) and (pointer: fine)").matches)
		root.dataset.overlayScrollbar = "";

	// No entrance replay when restoring from history
	const navEntry = performance.getEntriesByType("navigation")[0];
	if (navEntry && navEntry.type === "back_forward") root.dataset.noEnter = "";
</script>
