---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn press hide flex items-center rounded-2xl overflow-hidden transition-[opacity,transform,scale]">
        <button aria-label="Back to Top" class="btn-card h-15 w-15">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style>
	.back-to-top-wrapper {
		width: calc(var(--spacing) * 15);
		height: calc(var(--spacing) * 15);
		position: absolute;
		right: 0;
		top: 0;
		pointer-events: none;
	}

	.back-to-top-btn {
		color: var(--primary-text);
		font-size: var(--text-4xl);
		font-weight: bold;
		border: none;
		position: fixed;
		bottom: max(var(--spacing) * 8, 3vh);
		opacity: 1;
		cursor: pointer;
		transform: translateX(calc(var(--spacing) * 20));
		pointer-events: auto;

		&.hide {
			transform: translateX(calc(var(--spacing) * 20)) scale(0.9);
			opacity: 0;
			pointer-events: none;
		}
	}
</style>
