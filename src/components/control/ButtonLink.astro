---
interface Props {
	badge?: string;
	url?: string;
}
const { badge, url } = Astro.props;
---
<a href={url}>
    <span
        class:list={`
            flex flex-col justify-center
            w-full
            md:h-10 h-12
            rounded-lg
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            group
            transition-ui
            pl-2
            text-ui
            text-75
            hover:text-[var(--primary-text)]
        `
        }
    >
        <div class="flex items-center justify-between relative mr-2">
            <!-- Label nudges right on hover (transform instead of padding) -->
            <div class="overflow-hidden text-left whitespace-nowrap text-ellipsis transition-transform group-hover:translate-x-1">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="px-2 h-7 ml-4 min-w-8 rounded-lg text-meta font-bold
 text-[var(--btn-content)] dark:text-[var(--deep-text)]
 bg-[var(--btn-regular-bg)] dark:bg-[var(--primary)]
 flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
    </span>
</a>
