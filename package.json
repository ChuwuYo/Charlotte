{
	"name": "charlotte",
	"type": "module",
	"version": "0.0.3",
	"scripts": {
		"dev": "pnpm clean && astro dev",
		"start": "pnpm build && pnpm preview",
		"check": "astro check",
		"build": "pnpm clean && astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit --isolatedDeclarations",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write ./src",
		"lint": "biome check --write ./src",
		"preinstall": "npx only-allow pnpm",
		"clean": "rimraf .astro dist node_modules/.vite"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.1.1",
		"@expressive-code/core": "^0.44.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.3",
		"@expressive-code/plugin-line-numbers": "^0.44.3",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/roboto": "^5.3.0",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.96",
		"@iconify/svelte": "^5.2.3",
		"@iconify/utils": "^3.1.7",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.4.2",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"astrojs-atom": "^1.0.263",
		"hast-util-raw": "^9.1.0",
		"hastscript": "^9.0.1",
		"katex": "^0.19.1",
		"markdown-it": "^14.3.3",
		"mdast-util-to-string": "^4.0.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.6.3",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.19.2",
		"@types/sanitize-html": "^2.16.2",
		"rimraf": "^6.1.3"
	},
	"packageManager": "pnpm@10.34.9",
	"pnpm": {
		"overrides": {
			"sharp": "^0.35.5",
			"astrojs-atom>astro": "$astro",
			"katex": "$katex",
			"serialize-javascript": "^7.1.3",
			"@tailwindcss/typography>postcss-selector-parser": "^6.1.5"
		}
	}
}
